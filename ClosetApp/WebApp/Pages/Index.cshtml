@page
@model IndexModel
@using WebApp.Models.Domain;
@{
    ViewData["Title"] = "Home page";
}
<body class="home-page">
    <a href="/User">User</a>
    <h1>Your Closet</h1>
    
    <div class="slideshow-container">
        @foreach(var item in Model.ClothingItems)
        {
            if (item is TopBaseClothingItem && item.UserId == Model.appUser.UserId || item is TopBaseClothingItem && item.UserId == new Guid("ba3adfea-ef93-4639-85bc-e59d0f794571"))
            {
                <div class="mySlides">
                    <img src="data:image/*;base64, @Convert.ToBase64String(item.Image)" height="20%" width="20%" />
                </div>
            }
            
        }
        <a class="prev" onclick="plusSlides(-1)">&#10094;</a>
        <a class="next" onclick="plusSlides(1)">&#10095;</a>

    </div>
    <div class="slideshow-container1">
        @foreach (var item in Model.ClothingItems)
        {
            if ((item is BottomLayerClothingItem) && item.UserId == Model.appUser.UserId || item is BottomLayerClothingItem && item.UserId == new Guid("ba3adfea-ef93-4639-85bc-e59d0f794571"))
            {
                <div class="mySlides1">
                    <img src="data:image/*;base64, @Convert.ToBase64String(item.Image)" height="20%" width="20%" />
                </div>
            }
        }
        <a class="prev1" onclick="onClickHandler()">&#10094;</a>
        <a class="next1" onclick="plusSlides1(1)">&#10095;</a>
        
    </div>
    <button id="sendDataButton" type="button">Make Outfit</button>

</body>

