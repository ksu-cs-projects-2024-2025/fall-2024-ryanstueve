@page
@model IndexModel
@using WebApp.Models.Domain;
@{
    ViewData["Title"] = "Home page";
}
<body class="home-page">
    <h1>Your Closet</h1>
    @if (Model.ClothingItems != null && Model.ClothingItems.Any())
    {
        <div class="slideshow-container">
            @foreach(var item in Model.ClothingItems)
            {
                if (item is TopBaseClothingItem && item.UserId == Model.appUser.UserId || item is TopBaseClothingItem && item.UserId == new Guid("ba3adfea-ef93-4639-85bc-e59d0f794571"))
                {
                    <div class="mySlides">
                        <img src="~/@item.ImagePath" height="20%" width="20%" />
                    </div>
                }
            
            }
            <a class="prev" onclick="onClickHandler1()">&#10094;</a>
            <a class="next" onclick="onClickHandler2()">&#10095;</a>

        </div>
        <div class="slideshow-container1">
            @foreach (var item in Model.ClothingItems)
            {
                if ((item is BottomLayerClothingItem) && item.UserId == Model.appUser.UserId || item is BottomLayerClothingItem && item.UserId == new Guid("ba3adfea-ef93-4639-85bc-e59d0f794571"))
                {
                    <div class="mySlides1">
                        <img src="~/@item.ImagePath" height="20%" width="20%" />
                    </div>
                }
            }
            <a class="prev1" onclick="onClickHandler3()">&#10094;</a>
            <a class="next1" onclick="onClickHandler4()">&#10095;</a>
        
        </div>
        <form method="post" id="outfitForm">
            <button type="submit" id="outfitButton">Make Outfit</button>
        </form>
    }
    else{
        <p>No clothing items</p>
    }
</body>
    
