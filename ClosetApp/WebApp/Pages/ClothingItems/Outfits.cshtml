@page
@model WebApp.Pages.ClothingItems.OutfitsModel
@using Models.Domain;
@{

}
@using System.Drawing;


<h1 class="mb-3">List of Outfits</h1>

<form method="post" asp-page-handler="Generate" style="display:inline;">
    <button type="submit">Generate Outfits</button>
</form>

@if (Model.Outfits != null && Model.Outfits.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Outfit</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var outfit in Model.Outfits)
            {
                if (outfit.UserId == Model.appUser.UserId)
                {
                    <tr>
                        <td>
                            @foreach(var item in outfit.OutfitClothes)
                            {
                                <img src="~/@item.ImagePath" height="10%" width="10%" />
                            }
                        </td>
                        <td>
                            <form method="post" asp-page-handler="Delete" style="display:inline;">
                                <input type="hidden" name="id" value="@outfit.OutfitId" />
                                <button type="submit" onclick="return confirm('Are you sure you want to delete this outfit?')">Delete</button>
                            </form>
                        </td>
                    </tr>
                    
                }

            }
        </tbody>
    </table>
}
else
{
    <p>No outfits found</p>
}