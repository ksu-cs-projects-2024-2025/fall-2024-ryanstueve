@page
@model WebApp.Pages.ClothingItems.OutfitsModel
@using Models.Domain;
@{

}
@using System.Drawing;
@functions {
    public Image byteArrayToImage(byte[] byteArrayIn)
    {
        using (var ms = new MemoryStream(byteArrayIn))
        {
            return Image.FromStream(ms);
        }
    }
}

<h1 class="mb-3">List of Clothing Items</h1>

@if (Model.Outfits != null && Model.Outfits.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Color</th>
                <th>Material</th>
                <th>Top Design</th>
                <th>Bottom Design</th>
                <th>Image</th>
                <th> </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var outfit in Model.Outfits)
            {
                if (outfit.UserId == Model.appUser.UserId)
                {
                    <tr>
                        @foreach(var item in outfit.OutfitClothes)
                        {
                            <td><img src="data:image/*;base64, @Convert.ToBase64String(item.Image)" height="10%" width="10%" /></td>
                        }
                    </tr>
                    
                }

            }
        </tbody>
    </table>
}
else
{
    <p>No clothing items found</p>
}